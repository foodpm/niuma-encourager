{
  "name": "niuma-encourager-site",
  "private": true,
  "version": "1.0.0",
  "description": "牛马鼓励器官网 + 管理后台（Cloudflare Pages + Functions + D1）",
  "scripts": {
    "dev": "wrangler pages dev",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute niuma-stats --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute niuma-stats --remote --file=schema.sql",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
